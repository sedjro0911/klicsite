# =============================================================================
# Klic Site — variables d'environnement (exemples, sans valeurs réelles)
# Copier ce fichier vers .env.local et renseigner les valeurs en local / Vercel.
# Ne jamais committer .env.local ni aucune valeur secrète.
# =============================================================================

# --- Site (public) ---
# URL canonique du site (SEO, Open Graph, liens absolus)
NEXT_PUBLIC_SITE_URL=

# Numéro WhatsApp au format international, sans + (ex. 229XXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Formulaire de contact (serveur) ---
# Destinataire des messages du formulaire
CONTACT_TO_EMAIL=

# Expéditeur utilisé par le service d'envoi (domaine vérifié)
CONTACT_FROM_EMAIL=

# Clé API du prestataire d'e-mail transactionnel (ex. Resend)
RESEND_API_KEY=

# --- Anti-spam (Turnstile / reCAPTCHA) ---
# Clé site exposée au navigateur (préfixe NEXT_PUBLIC_ obligatoire)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Clé secrète de vérification côté serveur — jamais exposée au client
TURNSTILE_SECRET_KEY=
